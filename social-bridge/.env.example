# Public URL of this Social Bridge deployment. No trailing slash.
BASE_URL=https://YOUR-SOCIAL-BRIDGE-DOMAIN.example

# Meta app credentials. Never commit real values.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Set this to the Graph API version shown as current/supported in your Meta app.
# Example format only: vXX.X
META_GRAPH_VERSION=

# Dashboard protection.
ADMIN_USERNAME=hdc-owner
ADMIN_PASSWORD=

# Secret used to validate the Facebook OAuth state parameter.
STATE_SECRET=

# 32-byte key used to encrypt Page access tokens at rest.
# Recommended: 64 hex characters or base64 for exactly 32 bytes.
TOKEN_ENCRYPTION_KEY=

# Protects the MCP endpoint. ChatGPT/custom MCP connector should send:
# Authorization: Bearer <this value>
SOCIAL_BRIDGE_API_KEY=

# Recommended for deployment. Build 0.1 auto-creates its two tables.
DATABASE_URL=

# Optional PostgreSQL TLS behavior. Use true for hosted DBs that require SSL.
DATABASE_SSL=true
