# HDC Build 20 server-only environment variables. Never commit real values.

# normal | read_only | maintenance | incident
HDC_OPERATION_MODE=normal

# Portable PostgreSQL connection. HDC_DATABASE_URL takes precedence;
# DATABASE_URL remains accepted during the Build 12 migration period.
HDC_DATABASE_DRIVER=postgres
HDC_DATABASE_URL=
DATABASE_URL=

# Session signing supports one previous key during controlled rotation.
HDC_SESSION_KEY_ID=session-v1
HDC_SESSION_SECRET=
HDC_SESSION_SECRET_PREVIOUS_KEY_ID=
HDC_SESSION_SECRET_PREVIOUS=

# Keep recovery answers independent from session-key rotation. Before setting a
# new recovery pepper, preserve the former session secret as the legacy pepper.
HDC_RECOVERY_PEPPER_KEY_ID=recovery-v1
HDC_RECOVERY_PEPPER=
HDC_RECOVERY_LEGACY_PEPPER=
HDC_IDENTITY_FINGERPRINT_SECRET=

# Comma-separated exact HTTPS origins for hosted Flutter web clients.
# Local Flutter Chrome origins on localhost/127.0.0.1 are allowed separately.
HDC_WEB_ALLOWED_ORIGINS=

# Provider selectors contain non-secret adapter keys only. Credentials belong
# in the hosting secret store and use adapter-specific environment names.
HDC_EMAIL_PROVIDER=disabled
HDC_SMS_PROVIDER=disabled
HDC_PHONE_VERIFICATION_PROVIDER=disabled
HDC_OBJECT_STORAGE_PROVIDER=disabled
HDC_PAYMENT_PROVIDER=disabled

# Optional until the owner creates the dedicated security-review inbox.
# When set, manual recovery requests are added to the delivery outbox.
HDC_SECURITY_REVIEW_EMAIL=
